<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.atlas.controllers.hotel.ViewHotelsClientSideController"
            stylesheets="@../../css/viewHotelsClientSide.css">

    <HBox spacing="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <!-- Enhanced Sidebar -->
        <VBox styleClass="sidebar" prefWidth="320" spacing="0">
            <!-- Navigation Header -->
            <VBox styleClass="sidebar-header" spacing="15">
                <ImageView fitWidth="140" fitHeight="45" preserveRatio="true">
                    <Image url="@../../assets/ATLAS_LOGO.png" />
                </ImageView>
                <!--  <VBox spacing="12">
                      <Label text="Welcome back, Admin" styleClass="welcome-label"/>
                      <Button text="Add New Hotel" styleClass="add-button" onAction="#handleAddHotel">
                          <graphic>
                              <ImageView fitWidth="16" fitHeight="16">
                                  <Image url="@../../assets/icons/plusIcon.png" />
                              </ImageView>
                          </graphic>
                      </Button>
                  </VBox>-->
              </VBox>

              <!-- Navigation Section -->
            <VBox styleClass="nav-section" spacing="8">
                <Button text="Dashboard" styleClass="nav-button"/>
                <Button text="Bookings" styleClass="nav-button"/>
                <Button text="Reports" styleClass="nav-button"/>
            </VBox>

            <!-- Filter Section -->
            <ScrollPane fitToWidth="true" styleClass="filter-scroll" hbarPolicy="NEVER">
                <VBox styleClass="filter-container" spacing="20">
                    <!-- Price Range -->
                    <VBox styleClass="filter-group">
                        <Label text="PRICE RANGE (TND/NIGHT)" styleClass="filter-title"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="minPriceField" promptText="Min" styleClass="price-field"/>
                            <Label text="–" styleClass="price-separator"/>
                            <TextField fx:id="maxPriceField" promptText="Max" styleClass="price-field"/>
                        </HBox>
                    </VBox>

                    <!-- Star Rating -->
                    <VBox styleClass="filter-group">
                        <Label text="STAR RATING" styleClass="filter-title"/>
                        <VBox spacing="8">
                            <CheckBox fx:id="fiveStar" text="5 Stars ★★★★★" styleClass="rating-checkbox"/>
                            <CheckBox fx:id="fourStar" text="4 Stars ★★★★☆" styleClass="rating-checkbox"/>
                            <CheckBox fx:id="threeStar" text="3 Stars ★★★☆☆" styleClass="rating-checkbox"/>
                        </VBox>
                    </VBox>

                    <!-- Amenities -->
                    <VBox styleClass="filter-group">
                        <Label text="AMENITIES" styleClass="filter-title"/>
                        <VBox spacing="8">
                            <CheckBox fx:id="wifiCheck" text="Free WiFi" styleClass="amenity-checkbox"/>
                            <CheckBox fx:id="poolCheck" text="Swimming Pool" styleClass="amenity-checkbox"/>
                            <CheckBox fx:id="tvCheck" text="TV" styleClass="amenity-checkbox"/>
                            <CheckBox fx:id="acCheck" text="Air Conditioning" styleClass="amenity-checkbox"/>
                        </VBox>
                    </VBox>

                    <!-- Availability -->
                    <VBox styleClass="filter-group">
                        <Label text="MINIMUM ROOMS AVAILABLE" styleClass="filter-title"/>
                        <TextField fx:id="minRoomsField" promptText="Enter minimum rooms" styleClass="text-field"/>
                    </VBox>
                </VBox>
            </ScrollPane>

            <!-- Filter Actions -->
            <VBox styleClass="filter-actions" spacing="12">
                <Button text="APPLY FILTERS" styleClass="apply-button" onAction="#handleApplyFilters"/>
                <Button text="CLEAR FILTERS" styleClass="clear-button" onAction="#handleResetFilters"/>
            </VBox>
        </VBox>

        <!-- Main Content -->
        <VBox styleClass="main-content" spacing="20">
            <!-- Header -->
            <HBox styleClass="content-header" spacing="20" alignment="CENTER_LEFT">
                <VBox spacing="4">
                    <Label text="Where are you heading?" styleClass="content-title"/>
                    <Label fx:id="headerLabel" styleClass="content-subtitle"/>
                </VBox>
                <!-- Replace the TextField with this HBox structure -->
                <HBox  fx:id="searchContainer"   styleClass="search-container" alignment="CENTER_LEFT">
                    <ImageView fitWidth="20" fitHeight="20" styleClass="search-icon">
                        <Image url="@../../assets/icons/searchIcon.png" />
                    </ImageView>
                    <TextField fx:id="searchField" promptText="Search by hotel name..." styleClass="search-bar" />
                </HBox>
            </HBox>

            <!-- Hotel List -->
            <ScrollPane fitToHeight="true" fitToWidth="false" styleClass="scroll-pane"
                        vbarPolicy="NEVER" hbarPolicy="ALWAYS" pannable="true">

                <HBox>
                    <GridPane fx:id="hotelsGrid" vgap="25" hgap="25" gridLinesVisible="false"/>
                </HBox>

            </ScrollPane>
        </VBox>
    </HBox>
</AnchorPane>