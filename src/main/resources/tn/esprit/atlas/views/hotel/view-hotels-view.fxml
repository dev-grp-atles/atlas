<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.atlas.controllers.ViewHotelsController"
            stylesheets="@../../css/viewHotels.css">

    <HBox spacing="0" AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
        <!-- Navigation Sidebar -->
        <VBox styleClass="sidebar" prefWidth="280" spacing="20">
            <VBox styleClass="sidebar-header" spacing="10">
                <ImageView fitWidth="120" fitHeight="40" preserveRatio="true">
                    <Image url="@../../assets/ATLAS_LOGO.png" />
                </ImageView>
                <Label text="Welcome back,Admin" styleClass="welcome-label"/>
            </VBox>

            <VBox styleClass="nav-section" spacing="15">
                <Label text="TRIP PLANNER" styleClass="section-title"/>
                <Button text="Community" styleClass="nav-button"/>
                <Button text="Booking" styleClass="nav-button"/>
                <Button text="All Map" styleClass="nav-button"/>
            </VBox>

            <VBox styleClass="nav-section" spacing="15">
                <Label text="COMMUNITY" styleClass="section-title"/>
                <Button text="At Gulde" styleClass="nav-button"/>
                <Button text="Tuesday Destinations" styleClass="nav-button"/>
            </VBox>

            <VBox styleClass="start-journey-box">
                <Label text="Start Journey" styleClass="section-title"/>
                <Label text="Any place in mind?" styleClass="subtitle"/>
                <Button text="Plan My Trip" styleClass="cta-button"/>
            </VBox>
        </VBox>

        <!-- Main Content -->
        <VBox styleClass="main-content" spacing="15">
            <!-- Header -->
            <HBox styleClass="content-header">
                <VBox spacing="5">
                    <Label text="Where are you heading?" styleClass="content-title"/>
                    <Label fx:id="headerLabel" styleClass="content-subtitle"/>
                </VBox>
                <Button text="Sort by: Top picks" styleClass="nav-button"/>
            </HBox>

            <!-- Hotel List -->
            <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                <GridPane fx:id="hotelsGrid" vgap="20" hgap="20" gridLinesVisible="false"
                          styleClass="hotel-grid"/>
            </ScrollPane>
        </VBox>
    </HBox>
</AnchorPane>