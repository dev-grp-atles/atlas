<VBox prefHeight="526.0" prefWidth="1442.0" style="-fx-background-color: white; -fx-background-radius: 10;" stylesheets="@../../../css/admin.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.atlas.controllers.admin.offer.AddOfferController">
