<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.atlas.controllers.user.AddPostFormController">

    <children>
        <!-- VBox to hold the button and TreeView -->
        <VBox spacing="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.topAnchor="10">
            <!-- Post title -->
            <TextField fx:id="titleField" promptText="Enter title" />

            <!-- Category -->
            <TextField fx:id="category_Field" promptText="Enter category" />

            <!-- Content -->
            <TextArea fx:id="contentArea" prefRowCount="5" promptText="Enter content" />

            <!-- Add Post Button -->
            <Button onAction="#handleSubmitAction" text="Add Post" />

            <!-- Go to Forum Button -->
            <Button onAction="#handleGoToForumAction" text="Go to Forum" />
        </VBox>
    </children>
</AnchorPane>
