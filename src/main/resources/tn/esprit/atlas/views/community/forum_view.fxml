<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TreeView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.atlas.controllers.user.ForumController">

    <children>
        <!-- VBox to hold the label and buttons, centered -->
        <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10" alignment="CENTER">

            <!-- Welcome Label -->
            <Label text="Welcome to the Forum!" style="-fx-font-size: 16px; -fx-font-weight: bold;" />

            <!-- Add Post Button -->
            <Button text="Add Post" onAction="#handleAddPostButtonAction" />

            <!-- HBox to hold the 'Go to Menu' Button beside 'Add Post' -->
            <HBox spacing="10" alignment="CENTER">
                <Button text="Go to Menu" onAction="#handleGoToMenuButtonAction" />
            </HBox>

            <!-- TreeView for displaying posts, set VBox grow to take remaining space -->
            <TreeView fx:id="treeview" VBox.vgrow="ALWAYS"/>
        </VBox>
    </children>
</AnchorPane>
