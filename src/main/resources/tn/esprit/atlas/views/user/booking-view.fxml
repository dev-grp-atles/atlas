<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="604.0" prefWidth="887.0" spacing="10.0" styleClass="main" stylesheets="@../../css/home.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.atlas.controllers.user.booking.BookingController">
    <children>
        <VBox spacing="30.0">
            <children>
                <VBox prefHeight="0.0" prefWidth="887.0" spacing="5.0">
                    <children>
                        <Label styleClass="tab-title" text="Booking">
                            <font>
                                <Font name="Arial" size="28.0" />
                            </font>
                        </Label>
                        <Label text="Choose your travel options below" />
                    </children>
                </VBox>
                <HBox spacing="10.0">
                    <children>
                        <!-- Book Flight Button -->
                        <Button prefHeight="50.0" prefWidth="139.0" text="Book a Flight" textFill="WHITE" onAction="#loadBookFlightView" />
                        <!-- Book Hotel Button -->
                        <Button prefHeight="51.0" prefWidth="134.0" text="Book a Hotel" textFill="WHITE" onAction="#loadBookHotelView" />
                        <!-- Offers Button -->
                        <Button prefHeight="52.0" prefWidth="139.0" text="Offers" textFill="WHITE" onAction="#loadOffersView" />
                    </children>
                </HBox>
            </children>
        </VBox>
        <!-- Content Area -->
        <HBox prefHeight="422.0" prefWidth="866.0" VBox.vgrow="ALWAYS">
            <children>
                <StackPane fx:id="bookingContent" prefHeight="422.0" prefWidth="981.0" HBox.hgrow="ALWAYS" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</VBox>