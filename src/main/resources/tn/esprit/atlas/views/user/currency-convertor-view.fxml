<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@../../css/home.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.atlas.controllers.user.CurrencyConvertorController">
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-border-color: #2E86C1; -fx-border-width: 2; -fx-border-radius: 10; -fx-padding: 20; -fx-background-color: #F0F8FF; -fx-background-radius: 10;">
            <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2E86C1;" text="Currency Converter" />

            <!-- Champ de montant -->
            <VBox alignment="CENTER" spacing="10">
                <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="Amount" />
                <TextField fx:id="amountField" prefHeight="30.0" prefWidth="280.0" promptText="Enter amount" styleClass="input">
                    <VBox.margin>
                        <Insets left="100.0" right="100.0" />
                    </VBox.margin>
                </TextField>
            </VBox>

            <!-- Sélection des devises -->
            <HBox alignment="CENTER" spacing="20">
                <VBox alignment="CENTER" spacing="10">
                    <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="From Currency" />
                    <ComboBox fx:id="fromCurrency" promptText="Select currency" style="-fx-font-size: 14; -fx-pref-width: 150; -fx-padding: 5;" />
                </VBox>
                <VBox alignment="CENTER" spacing="10">
                    <Label style="-fx-font-size: 16; -fx-font-weight: bold;" text="To Currency" />
                    <ComboBox fx:id="toCurrency" promptText="Select currency" style="-fx-font-size: 14; -fx-pref-width: 150; -fx-padding: 5;" />
                </VBox>
            </HBox>

            <!-- Bouton de conversion -->
            <Button onAction="#convertCurrency" style="-fx-font-size: 16; -fx-background-color: #2E86C1; -fx-text-fill: white; -fx-padding: 10 20;" text="Convert Currency" />

            <!-- Résultat de la conversion -->
            <Label fx:id="resultLabel" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2E86C1;" text="Converted Amount: " />
        </VBox>
    </center>
</BorderPane>
