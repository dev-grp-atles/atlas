<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="342.0" prefWidth="1500.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.atlas.controllers.user.booking.OfferDetailsController">
    <children>

        <!-- Details and Image -->
        <HBox alignment="CENTER_LEFT" prefHeight="343.0" prefWidth="1014.0" spacing="20">
            <!-- Left Side: Details -->
            <VBox spacing="10" style="-fx-padding: 0 20px 0 0;" HBox.hgrow="ALWAYS">
                <Label fx:id="nameLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                <Label fx:id="destinationsLabel" style="-fx-font-size: 18px;" />
                <Label fx:id="durationLabel" style="-fx-font-size: 16px;" />
                <Label fx:id="priceLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
                <Label fx:id="descriptionLabel" style="-fx-font-size: 16px;" wrapText="true" />
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            </VBox>

            <!-- Right Side: Image and Name -->
            <VBox alignment="TOP_RIGHT" spacing="10">
            <HBox alignment="TOP_RIGHT">
               <children>
                     <Button style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10px; -fx-background-radius: 5px;" text="Reserve" onMouseClicked="#handleReserveButtonClick" />
               </children>
            </HBox>
                <ImageView fx:id="offerImage" fitHeight="200" fitWidth="300" preserveRatio="true" />
                <Label fx:id="offerName" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            </VBox>
        </HBox>
    </children>
</VBox>
