<VBox fx:id="overviewController" prefHeight="505.0" prefWidth="979.0" spacing="10.0" styleClass="main" stylesheets="@../../css/home.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <HBox alignment="CENTER" prefHeight="70.0" prefWidth="638.0" spacing="10.0">
