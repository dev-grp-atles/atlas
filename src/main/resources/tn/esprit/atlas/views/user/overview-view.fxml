                <StackPane prefHeight="82.0" prefWidth="70.0" styleClass="button">
                    <children>
                        <ImageView fitHeight="32.0" fitWidth="36.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../../assets/icons/plane_icon.png" />
                            </image>
                        </ImageView>
                    </children>
                    <HBox.margin>
                        <Insets />
                    </HBox.margin>
                </StackPane>
            </children>
        </HBox>
        <HBox spacing="10.0">
            <children>
                <VBox prefHeight="215.0" prefWidth="416.0" spacing="15.0" styleClass="widget">
                    <children>
                        <VBox>
                            <children>
                                <Label styleClass="widget-title" text="Community" />
