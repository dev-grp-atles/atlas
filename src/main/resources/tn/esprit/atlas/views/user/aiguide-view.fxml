<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" prefHeight="554.0" prefWidth="798.0" styleClass="main" stylesheets="@../../css/home.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.atlas.controllers.user.AiGuideController">
   <children>
      <ScrollPane fx:id="chatScrollPane" prefHeight="461.0" prefWidth="798.0" style="-fx-border-color: transparent;" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
         <content>
            <VBox fx:id="chatBox" spacing="10.0" />
         </content>
      </ScrollPane>
      <Pane prefHeight="46.0" prefWidth="751.0" VBox.vgrow="ALWAYS" />
      <HBox prefHeight="46.0" spacing="10.0" VBox.vgrow="ALWAYS">
         <children>
            <TextField fx:id="userInput" prefHeight="117.0" prefWidth="697.0" promptText="Type your message here..." styleClass="input" HBox.hgrow="ALWAYS" />
            <Button fx:id="sendButton" onAction="#handleSendMessage" prefHeight="117.0" prefWidth="139.0" text="Send" textFill="WHITE" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
