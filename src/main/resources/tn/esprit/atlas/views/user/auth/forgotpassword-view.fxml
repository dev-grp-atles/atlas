<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="forgotPasswordPane" alignment="CENTER" spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.atlas.controllers.user.auth.ForgotPasswordController">
    <Label text="Forgot Password" font="$x2" />
    <Label text="Enter your email to reset your password:" />
    <TextField fx:id="emailField" promptText="Email" />
    <Button fx:id="resetPasswordButton" text="Reset Password" onAction="#handleResetPassword" />
    <Button fx:id="goBackButton" text="Go Back" onAction="#handleGoBack" />
</VBox>